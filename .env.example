# ============================================
# RutaIA - Variables de entorno de ejemplo
# Copia este archivo como .env y reemplaza los valores.
# NUNCA subas el archivo .env a GitHub.
# ============================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=rutaia
MYSQL_USER=rutaia_user
MYSQL_PASSWORD=cambia_esta_clave
MYSQL_PORT=3306

# ---------- Qdrant ----------
QDRANT_PORT=6333
QDRANT_COLLECTION=cursos

# ---------- n8n ----------
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/consulta-rag

# ---------- OpenRouter ----------
OPENROUTER_API_KEY=sk-or-v1-tu_key_aqui
# Modelos (se definen el Día 2)
OPENROUTER_EMBEDDING_MODEL=definir_dia_2
OPENROUTER_CHAT_MODEL=definir_dia_2

# ---------- RAG ----------
# Umbral mínimo de similitud (se justifica el Día 2)
RAG_UMBRAL_SIMILITUD=0.45
RAG_LIMITE_RESULTADOS=5
